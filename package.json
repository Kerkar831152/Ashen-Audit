{
  "name": "ashen-audit",
  "displayName": "AshenAudit",
  "publisher": "VithalKerkar",
  "type": "module",
  "description": "AI-assisted code verification, review, and improvement inside VS Code.",
  "version": "0.0.2",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kerkar831152/Ashen-Audit.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "ashen-audit.verifyCode",
        "title": "AshenAudit: Verify Selected Code"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "dotenv": "^18.0.1",
    "groq-sdk": "^1.6.0",
    "openai": "^7.20.0",
    "serpapi": "^2.2.1"
  }
}